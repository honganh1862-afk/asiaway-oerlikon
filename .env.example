# Copy to .env and fill in. NEVER commit a filled-in .env.

# --- Database -----------------------------------------------------------
# Required in production. Without it, development falls back to an in-process
# PGlite database under .pglite/ so the app runs with no infrastructure.
DATABASE_URL=postgres://asiaway:password@localhost:5432/asiaway
POSTGRES_PASSWORD=change-me

# --- Application --------------------------------------------------------
# The public address. The table cards (npm run qr) default to each
# restaurant's Vercel address; set this to print cards for another one.
APP_BASE_URL=http://localhost:3000

# Which restaurant this deployment serves: oerlikon (the default) or
# winterthur. Picks the Thai menu, the Saturday menu and how guests pay. Each
# restaurant is its own deployment with its own database and address. Read at
# BUILD time, so changing it needs a rebuild.
NEXT_PUBLIC_RESTAURANT_LOCATION=oerlikon

# Timestamps are stored in UTC and rendered in this zone. Confirm with the
# restaurant (open question E8).
NEXT_PUBLIC_RESTAURANT_TIMEZONE=Europe/Zurich

# --- Provisioning -------------------------------------------------------
# Protects /api/admin/setup, which creates the schema and loads the menu and
# tables. WITHOUT THIS SET THE ENDPOINT REFUSES EVERY REQUEST.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Seeding ------------------------------------------------------------
# The demo seed refuses to touch a DATABASE_URL database unless this is set.
# SEED_ALLOW_PROD=1
